<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My workouts | <%= siteName %></title>
    <link rel="stylesheet" href="<%= basePath %>/main.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main class="container page-shell">
      <header class="page-heading heading-with-action">
        <div>
          <span class="eyebrow">Activity history</span>
          <h1>My workouts</h1>
          <p>Review, edit or remove the fitness sessions linked to your account.</p>
        </div>
        <div class="button-row">
          <a class="button button-secondary" href="<%= basePath %>/workouts/quick">Quick workouts</a>
          <a class="button button-primary" href="<%= basePath %>/workouts/new">Log a workout</a>
        </div>
      </header>

      <section class="panel">
        <% if (workouts.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Exercise</th><th>Category</th><th>Date</th><th>Duration</th><th>Calories</th><th>Actions</th></tr>
              </thead>
              <tbody>
                <% workouts.forEach(function(workout) { %>
                  <tr>
                    <td>
                      <strong><%= workout.exercise_name %></strong>
                      <% if (workout.notes) { %><small class="table-note"><%= workout.notes %></small><% } %>
                    </td>
                    <td><span class="tag"><%= workout.category %></span></td>
                    <td><%= formatDate(workout.workout_date) %></td>
                    <td><%= workout.duration_minutes %> min</td>
                    <td><%= workout.calories_burned %></td>
                    <td>
                      <div class="table-actions">
                        <a href="<%= basePath %>/workouts/<%= workout.id %>/edit">Edit</a>
                        <form action="<%= basePath %>/workouts/<%= workout.id %>/delete" method="post" onsubmit="return confirm('Delete this workout?');">
                          <button class="danger-link" type="submit">Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <h2>Your workout list is empty</h2>
            <p>Add a session and it will appear here.</p>
            <a class="button button-primary" href="<%= basePath %>/workouts/new">Log a workout</a>
          </div>
        <% } %>
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
