<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Create account | <%= siteName %></title>
    <link rel="stylesheet" href="/main.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main class="container form-page">
      <section class="form-intro">
        <span class="eyebrow">Create your account</span>
        <h1>Turn activity into a habit.</h1>
        <p>Your account keeps workout entries private and connects every record to your personal dashboard.</p>
      </section>

      <section class="form-card">
        <h2>Register</h2>
        <% if (errors.length) { %>
          <div class="alert alert-error">
            <ul>
              <% errors.forEach(function(error) { %><li><%= error.msg %></li><% }); %>
            </ul>
          </div>
        <% } %>
        <form action="/register" method="post">
          <div class="field-pair">
            <div>
              <label for="first_name">First name</label>
              <input id="first_name" name="first_name" value="<%= formData.first_name || '' %>" required>
            </div>
            <div>
              <label for="last_name">Last name</label>
              <input id="last_name" name="last_name" value="<%= formData.last_name || '' %>" required>
            </div>
          </div>

          <label for="email">Email</label>
          <input id="email" name="email" type="email" value="<%= formData.email || '' %>" required>

          <label for="username">Username</label>
          <input id="username" name="username" value="<%= formData.username || '' %>" autocomplete="username" required>

          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" required>
          <small>At least 8 characters with lowercase, uppercase, a number and a symbol.</small>

          <button class="button button-primary button-full" type="submit">Create account</button>
        </form>
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
